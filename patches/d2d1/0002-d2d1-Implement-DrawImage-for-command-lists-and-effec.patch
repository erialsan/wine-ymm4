+static HRESULT d2d_command_sink_create(struct d2d_device_context *context, ID2D1CommandSink **sink)
+{
+    struct d2d_command_sink *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1CommandSink_iface.lpVtbl = &d2d_command_sink_vtbl;
+    object->refcount = 1;
+    object->context = context;
+
+    *sink = &object->ID2D1CommandSink_iface;
+    return S_OK;
+}
+
 static void STDMETHODCALLTYPE d2d_device_context_DrawImage(ID2D1DeviceContext6 *iface, ID2D1Image *image,
         const D2D1_POINT_2F *target_offset, const D2D1_RECT_F *image_rect, D2D1_INTERPOLATION_MODE interpolation_mode,
         D2D1_COMPOSITE_MODE composite_mode)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
     ID2D1Bitmap *bitmap;
+    ID2D1CommandList *command_list;
 
     TRACE("iface %p, image %p, target_offset %s, image_rect %s, interpolation_mode %#x, composite_mode %#x.\n",
             iface, image, debug_d2d_point_2f(target_offset), debug_d2d_rect_f(image_rect),
@@ -2755,9 +3063,117 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawImage(ID2D1DeviceContext6 *
         return;
     }
 
+/* Replay the command list onto the target. */
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1CommandList, (void **)&command_list)))
+    {
+        ID2D1CommandSink *sink;
+
+        if (SUCCEEDED(d2d_command_sink_create(context, &sink)))
+        {
+            /* Apply the target offset as a translation in target space
+             * (matches Windows behavior: DrawImage(cl, off) shifts the
+             * replayed content by off). */
+            if (target_offset)
+            {
+                D2D1_MATRIX_3X2_F old, t;
+                ID2D1RenderTarget_GetTransform((ID2D1RenderTarget *)&context->ID2D1DeviceContext6_iface, &old);
+                t = old;
+                t._31 += target_offset->x;
+                t._32 += target_offset->y;
+                ID2D1RenderTarget_SetTransform((ID2D1RenderTarget *)&context->ID2D1DeviceContext6_iface, &t);
+                ID2D1CommandList_Stream(command_list, sink);
+                ID2D1RenderTarget_SetTransform((ID2D1RenderTarget *)&context->ID2D1DeviceContext6_iface, &old);
+            }
+            else
+                ID2D1CommandList_Stream(command_list, sink);
+            ID2D1CommandSink_Release(sink);
+        }
+
+        ID2D1CommandList_Release(command_list);
+        return;
+    }
+
+    /* Approximate rendering of the well-known built-in effect graph. */
+    {
+        static const CLSID clsid_2daffine = {0x6aa97485,0x6354,0x4cfc,{0x90,0x8c,0xe4,0xa7,0x4f,0x62,0xc9,0x6c}};
+        static const CLSID clsid_3dtransform = {0xe8467b04,0xec61,0x4b8a,{0xb5,0xde,0xd4,0xd7,0x3d,0xeb,0xea,0x5a}};
+        static const CLSID clsid_crop = {0xe23f7110,0x0e9a,0x4324,{0xaf,0x47,0x6a,0x2c,0x0c,0x46,0xf3,0x5b}};
+        ID2D1Effect *effect;
+        if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Effect, (void **)&effect)))
+        {
+            ID2D1RenderTarget *rt = (ID2D1RenderTarget *)&context->ID2D1DeviceContext6_iface;
+            ID2D1Image *input = NULL;
+            CLSID id;
+            D2D1_MATRIX_3X2_F old_transform;
+            BOOL have_transform = FALSE, have_clip = FALSE;
+            D2D1_RECT_F clip_rect;
+
+            memset(&id, 0, sizeof(id));
+            ID2D1Effect_GetValue(effect, D2D1_PROPERTY_CLSID, D2D1_PROPERTY_TYPE_CLSID, (BYTE *)&id, sizeof(id));
+
+            if (IsEqualGUID(&id, &clsid_2daffine) || IsEqualGUID(&id, &clsid_3dtransform))
+            {
+                D2D1_MATRIX_3X2_F m;
+                HRESULT ghr;
+                memset(&m, 0, sizeof(m));
+                m._11 = m._22 = 1.0f;
+                if (IsEqualGUID(&id, &clsid_2daffine))
+                {
+                    ghr = ID2D1Effect_GetValue(effect, 2 /*TRANSFORM_MATRIX*/, D2D1_PROPERTY_TYPE_MATRIX_3X2, (BYTE *)&m, sizeof(m));
+                }
+                else
+                {
+                    D2D1_MATRIX_4X4_F m4;
+                    memset(&m4, 0, sizeof(m4));
+                    ghr = ID2D1Effect_GetValue(effect, 2 /*TRANSFORM_MATRIX*/, D2D1_PROPERTY_TYPE_MATRIX_4X4, (BYTE *)&m4, sizeof(m4));
+                    m._11 = m4._11; m._12 = m4._12; m._21 = m4._21; m._22 = m4._22;
+                    m._31 = m4._41; m._32 = m4._42;
+                }
+                ID2D1RenderTarget_GetTransform(rt, &old_transform);
+                {
+                    D2D1_MATRIX_3X2_F combined;
+                    combined._11 = m._11 * old_transform._11 + m._12 * old_transform._21;
+                    combined._12 = m._11 * old_transform._12 + m._12 * old_transform._22;
+                    combined._21 = m._21 * old_transform._11 + m._22 * old_transform._21;
+                    combined._22 = m._21 * old_transform._12 + m._22 * old_transform._22;
+                    combined._31 = m._31 * old_transform._11 + m._32 * old_transform._21 + old_transform._31;
+                    combined._32 = m._31 * old_transform._12 + m._32 * old_transform._22 + old_transform._32;
+                    ID2D1RenderTarget_SetTransform(rt, &combined);
+                    have_transform = TRUE;
+                }
+            }
+            else if (IsEqualGUID(&id, &clsid_crop))
+            {
+                D2D1_VECTOR_4F v4;
+                if (SUCCEEDED(ID2D1Effect_GetValue(effect, 0 /*RECT*/, D2D1_PROPERTY_TYPE_VECTOR4, (BYTE *)&v4, sizeof(v4))))
+                {
+                    /* Skip "infinite" crop rects (default = no crop). */
+                    if (v4.x > -1.0e7f && v4.y > -1.0e7f && v4.z < 1.0e7f && v4.w < 1.0e7f)
+                    {
+                        clip_rect.left = v4.x; clip_rect.top = v4.y; clip_rect.right = v4.z; clip_rect.bottom = v4.w;
+                        ID2D1RenderTarget_PushAxisAlignedClip(rt, &clip_rect, D2D1_ANTIALIAS_MODE_ALIASED);
+                        have_clip = TRUE;
+                    }
+                }
+            }
+
+            ID2D1Effect_GetInput(effect, 0, &input);
+            if (input)
+            {
+                d2d_device_context_DrawImage(iface, input, target_offset, image_rect, interpolation_mode, composite_mode);
+                ID2D1Image_Release(input);
+            }
+            if (have_clip) ID2D1RenderTarget_PopAxisAlignedClip(rt);
+            if (have_transform) ID2D1RenderTarget_SetTransform(rt, &old_transform);
+            ID2D1Effect_Release(effect);
+            return;
+        }
+    }
+
     FIXME("Unhandled image %p.\n", image);
 }
 
+
 static void STDMETHODCALLTYPE d2d_device_context_DrawGdiMetafile(ID2D1DeviceContext6 *iface,
         ID2D1GdiMetafile *metafile, const D2D1_POINT_2F *target_offset)
 {
-- 
2.56.0

