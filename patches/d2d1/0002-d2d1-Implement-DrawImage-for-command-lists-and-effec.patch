From e99de8b1324d13740f07a038e2e79edb44570045 Mon Sep 17 00:00:00 2001
From: maebahesioru <maebahesioru@users.noreply.github.com>
Date: Sat, 17 Oct 2026 10:17:45 +0900
Subject: [PATCH 2/5] d2d1: Implement DrawImage() for command lists and effect
 images.

Replay recorded command lists onto the target through an ID2D1CommandSink
implementation that forwards the recorded commands to the device context,
applying the target offset as a translation.

Effect images are rendered by recursing into input 0 and applying the
properties of the standard transform and crop effects.  Flood, shadow
and color matrix effects are not rendered yet.
---
 dlls/d2d1/device.c | 416 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 416 insertions(+)

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 687b76ce..20a2f48d 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2717,12 +2717,320 @@ static void STDMETHODCALLTYPE d2d_device_context_ID2D1DeviceContext_DrawGlyphRun
     d2d_device_context_draw_glyph_run(context, baseline_origin, glyph_run, glyph_run_desc, brush, measuring_mode);
 }
 
+struct d2d_command_sink
+{
+    ID2D1CommandSink ID2D1CommandSink_iface;
+    LONG refcount;
+    struct d2d_device_context *context;
+};
+
+static inline struct d2d_command_sink *impl_from_ID2D1CommandSink(ID2D1CommandSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_command_sink, ID2D1CommandSink_iface);
+}
+
+#define SINK_RT(sink) ((ID2D1RenderTarget *)&(sink)->context->ID2D1DeviceContext6_iface)
+#define SINK_DC(sink) ((ID2D1DeviceContext *)&(sink)->context->ID2D1DeviceContext6_iface)
+#define SINK_DC1(sink) ((ID2D1DeviceContext1 *)&(sink)->context->ID2D1DeviceContext6_iface)
+
+static HRESULT STDMETHODCALLTYPE d2d_command_sink_QueryInterface(ID2D1CommandSink *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1CommandSink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1CommandSink_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_command_sink_AddRef(ID2D1CommandSink *iface)
+{
+    struct d2d_command_sink *sink = impl_from_ID2D1CommandSink(iface);
+
+    return InterlockedIncrement(&sink->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE d2d_command_sink_Release(ID2D1CommandSink *iface)
+{
+    struct d2d_command_sink *sink = impl_from_ID2D1CommandSink(iface);
+    ULONG refcount = InterlockedDecrement(&sink->refcount);
+
+    if (!refcount)
+        free(sink);
+
+    return refcount;
+}
