From 5307a2e2b9e3c99cc9aaaacdbc6aaaaf07982900 Mon Sep 17 00:00:00 2001
From: maebahesioru <maebahesioru@users.noreply.github.com>
Date: Sat, 17 Oct 2026 10:17:45 +0900
Subject: [PATCH 1/5] d2d1: Support EndDraw() on a command list target.

Windows allows ending a draw sequence recorded into a command list and
requires calling Close() on the list afterwards.  Report the tags and
the current error state like for any other target.
---
 dlls/d2d1/device.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 552d6d4c..687b76ce 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2072,8 +2072,12 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_EndDraw(ID2D1DeviceContext6
 
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
     {
-        FIXME("Unimplemented for command list target.\n");
-        return E_NOTIMPL;
+        if (tag1)
+            *tag1 = context->error.tag1;
+        if (tag2)
+            *tag2 = context->error.tag2;
+
+        return context->error.code;
     }
 
     if (tag1)
-- 
2.56.0

