@@ -2513,6 +2513,46 @@ void attach_client_window( struct x11drv_win_data *data, Window client_window )
     data->client_window = client_window;
 }
 
+/* YMM4 fix: attach a child surface window directly to its toplevel X window so that
+ * native D3D/Vulkan presents (DXVK) become visible. Called from the vulkan driver paths
+ * in a context where no win_data lock is held. Gated by env var WINE_X11_CHILD_SURFACE_ATTACH. */
+void x11drv_attach_child_surface( HWND hwnd, Window window )
+{
+    static HWND last_hwnd;
+    static Window last_window, last_top;
+    static int last_x, last_y, last_w, last_h;
+    HWND toplevel = NtUserGetAncestor( hwnd, GA_ROOT );
+    struct x11drv_win_data *data;
+    RECT wrect, trect;
+    Window top_window;
+    int x, y, w, h;
+
+    if (!toplevel || toplevel == hwnd) return;
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) == NtUserGetDesktopWindow()) return; /* child windows only */
+    if (!NtUserGetWindowRect( hwnd, &wrect, NtUserGetDpiForWindow( hwnd ) ) ||
+        !NtUserGetWindowRect( toplevel, &trect, NtUserGetDpiForWindow( toplevel ) )) return;
+    w = wrect.right - wrect.left;
+    h = wrect.bottom - wrect.top;
+    if (w <= 0 || h <= 0) return; /* not laid out yet; retry on a later update */
+    w = min( max( 1, w ), 65535 );
+    h = min( max( 1, h ), 65535 );
+    if (!(data = get_win_data( toplevel ))) return;
+    top_window = data->whole_window;
+    release_win_data( data );
+    if (!top_window) return;
+    x = wrect.left - trect.left;
+    y = wrect.top - trect.top;
+    if (hwnd == last_hwnd && window == last_window && top_window == last_top &&
+        x == last_x && y == last_y && w == last_w && h == last_h) return;
+    last_hwnd = hwnd; last_window = window; last_top = top_window;
+    last_x = x; last_y = y; last_w = w; last_h = h;
+    WARN( "attach-child: %p window %lx -> %lx at %d,%d size %dx%d\n", hwnd, window, top_window, x, y, w, h );
+    XReparentWindow( gdi_display, window, top_window, x, y );
+    XMoveResizeWindow( gdi_display, window, x, y, w, h );
+    XMapRaised( gdi_display, window );
+    XFlush( gdi_display );
+}
