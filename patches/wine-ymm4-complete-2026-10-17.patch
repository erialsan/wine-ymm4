+static HRESULT STDMETHODCALLTYPE d2d_command_sink_SetTransform(ID2D1CommandSink *iface, const D2D1_MATRIX_3X2_F *transform)
+{
+    struct d2d_command_sink *sink = impl_from_ID2D1CommandSink(iface);
+
+    if (sink->context->replay_offset_valid)
+    {
+        /* YMM4 compatibility: a target offset passed to DrawImage() shifts the
+         * whole replayed command list, including nested lists and any
+         * transforms the list records. */
+        D2D1_MATRIX_3X2_F t = *transform;
+        t._31 += sink->context->replay_offset.x;
+        t._32 += sink->context->replay_offset.y;
+        ID2D1RenderTarget_SetTransform(SINK_RT(sink), &t);
+    }
+    else
+    {
+        ID2D1RenderTarget_SetTransform(SINK_RT(sink), transform);
+    }
+    return S_OK;
+}
